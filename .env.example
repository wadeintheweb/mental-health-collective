# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Google API Key for Gemini models
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY="your-google-api-key-here"

# Google Cloud Project Configuration
OMHC_GCP_PROJECT_ID="your-gcp-project-id"
OMHC_GCP_LOCATION="us-west1"

# Optional: Vertex AI Agent Engine Resource Name
# OMHC_AGENT_ENGINE_RESOURCE_NAME="projects/YOUR_PROJECT/locations/YOUR_LOCATION/reasoningEngines/YOUR_ENGINE_ID"

# Optional: Google Application Credentials (for service accounts)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Gemini Model Configuration
OMHC_MODEL_NAME="gemini-2.0-flash"

# Optional: MCP Server URL
MENTAL_HEALTH_MCP_URL="http://localhost:8002/sse"

# Optional: A2A Server Configuration
# OMHC_A2A_SERVER_HOST="localhost"
# OMHC_A2A_SERVER_PORT="8101"
# OMHC_A2A_BASE_URL="http://localhost:8101"
