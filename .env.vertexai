# =============================================================================
# OMHC Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud Configuration (Required for Deployment)
# -----------------------------------------------------------------------------

# Your Google Cloud Project ID
# Example: OMC_GCP_PROJECT_ID=my-mental-health-project
OMC_GCP_PROJECT_ID=

# GCP Region/Location for deployment
# Common values: us-central1, us-east1, europe-west1, asia-southeast1
OMC_GCP_LOCATION=us-central1

# Agent Engine Resource Name (obtained after first deployment)
# Example: projects/my-project/locations/us-central1/agentEngines/omhc-orchestrator-abc123
OMC_AGENT_ENGINE_RESOURCE_NAME=

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------

# Gemini model to use for all agents
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
OMHC_MODEL_NAME=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Authentication (Required for Local Development)
# -----------------------------------------------------------------------------

# Google API Key for local testing with Gemini
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Google Application Credentials (alternative to API key)
# Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) Configuration
# -----------------------------------------------------------------------------

# MCP Server URL for crisis hotline resources
# Local development: http://127.0.0.1:8002/sse
# Cloud Run production: https://your-mcp-service-url.run.app/sse
# Leave empty to use Google Search only
MENTAL_HEALTH_MCP_URL=

# MCP Server Port (for local development)
OMC_MCP_PORT=8002

# -----------------------------------------------------------------------------
# A2A (Agent-to-Agent) Configuration
# -----------------------------------------------------------------------------

# A2A Server Configuration (for agent interoperability)
OMHC_A2A_SERVER_HOST=127.0.0.1
OMHC_A2A_SERVER_PORT=8001
OMHC_A2A_BASE_URL=http://127.0.0.1:8001

# -----------------------------------------------------------------------------
# Optional: Development & Testing
# -----------------------------------------------------------------------------

# Test App Name (for local testing)
# OMHC_TEST_APP_NAME=omhc_local_test

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Enable verbose logging for debugging
# DEBUG_MODE=false

# -----------------------------------------------------------------------------
# Example Complete Configuration
# -----------------------------------------------------------------------------
# Here's what a fully configured .env might look like:
#
# OMC_GCP_PROJECT_ID=mental-health-prod
# OMC_GCP_LOCATION=us-central1
# OMC_AGENT_ENGINE_RESOURCE_NAME=projects/mental-health-prod/locations/us-central1/agentEngines/omhc-main
# OMHC_MODEL_NAME=gemini-2.0-flash
# GOOGLE_API_KEY=AIzaSy...actual_key_here
# MENTAL_HEALTH_MCP_URL=https://omhc-mcp-server-abc123.run.app/sse
# OMHC_A2A_BASE_URL=http://127.0.0.1:8001
